# ── Personal configuration (never commit) ────────────────────────────────────
config.local.yaml

# ── Pipeline runtime outputs ──────────────────────────────────────────────────
data/
results/
logs/
reports/

# ── Snakemake internals ───────────────────────────────────────────────────────
.snakemake/
*.snakemake.log

# ── Conda environments (built automatically by Snakemake) ────────────────────
.conda/

# ── Vendored tools: keep the code, drop the runtime cruft ────────────────────
tools/**/__pycache__/
tools/MC2/output/
tools/**/.git/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
